# Copy to .env and adjust. Every value here has a default in rag/config.py.

# --- Ollama (runs locally; nothing leaves the machine) ---
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2:3b

# --- Vector store (relative paths are relative to the project root) ---
CHROMA_DIR=chroma_db
COLLECTION_NAME=knowledge_base

# --- Chunking (re-run steps/step_04_index.py after changing these) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=4
# Chunks with cosine similarity below this are dropped before prompting.
MIN_SCORE=0.25
